{  
"compilerOptions": { 
"target": "ES2020", 
"module": "commonjs", 
"moduleResolution": "node", 
"rootDir": "src", 
"outDir": "dist", 
"strict": true, 
"esModuleInterop": true,
"skipLibCheck": true,
"forceConsistentCasingInFileNames": true,
"sourceMap": false,
"types": ["node"]
},
    "include": ["src"], 
    "exclude": ["node_modules", "dist"]
}